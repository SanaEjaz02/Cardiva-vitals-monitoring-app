#!/bin/bash
# Auto-updates the Recent Activity section in CLAUDE.md after every commit.

CLAUDE_FILE="CLAUDE.md"
START_MARKER="<!-- ACTIVITY:START -->"
END_MARKER="<!-- ACTIVITY:END -->"
TEMP_ACTIVITY="/tmp/cardiva_activity_$$.txt"

[ ! -f "$CLAUDE_FILE" ] && exit 0

# Generate last 15 commits as markdown list
git log --format="- \`%ad\` **%an**: %s" --date=format:"%Y-%m-%d" -15 > "$TEMP_ACTIVITY"

# Replace content between markers using awk
awk -v start="$START_MARKER" -v end="$END_MARKER" -v actfile="$TEMP_ACTIVITY" '
BEGIN { printing = 1 }
{
    if ($0 == start) {
        print $0
        while ((getline line < actfile) > 0) print line
        printing = 0
    } else if ($0 == end) {
        print $0
        printing = 1
    } else if (printing) {
        print $0
    }
}
' "$CLAUDE_FILE" > "${CLAUDE_FILE}.tmp" && mv "${CLAUDE_FILE}.tmp" "$CLAUDE_FILE"

rm -f "$TEMP_ACTIVITY"
echo "  CLAUDE.md activity updated"
